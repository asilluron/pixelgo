# Server
PIXELGO_ADDR=:8080
PIXELGO_ENV=development

# Redis (pixel counters + pixel metadata only; users/orgs/sessions live in Supabase)
PIXELGO_REDIS_URL=redis://localhost:6379/0

# Signed app cookies (32+ random bytes; change in production)
PIXELGO_SESSION_SECRET=change-me-to-a-long-random-string
PIXELGO_SESSION_TTL=168h

# Bootstrap super-admin. On first boot (no profile has is_super_admin=true),
# pixelgo creates this user via the Supabase Admin API.
PIXELGO_BOOTSTRAP_EMAIL=admin@example.com
PIXELGO_BOOTSTRAP_PASSWORD=changeme

# Per-IP rate limit for /p/:id (token bucket, in-memory per instance).
# Tuned for large NAT/CDN pops; set PIXELGO_RL_DISABLE=1 to turn off.
PIXELGO_RL_PER_SEC=200
PIXELGO_RL_BURST=400
# PIXELGO_RL_DISABLE=1

# --- Supabase (required: auth + orgs + invites) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Transaction pooler URL, port 6543. URL-encode the password if it contains
# reserved characters.
SUPABASE_DB_URL=postgres://postgres:PASSWORD@db.your-project-ref.supabase.co:6543/postgres
